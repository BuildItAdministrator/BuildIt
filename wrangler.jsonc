{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "buildit-app",
  "main": "./cloudflare/production/worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildit-production",
      "database_id": "REPLACE_WITH_NEW_PRODUCTION_D1_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
